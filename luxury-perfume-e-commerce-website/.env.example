# ── Supabase / Postgres ─────────────────────────────────────────────
# Runtime (Vercel): Supabase TRANSACTION POOLER — port 6543.
# Format: postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Migrations & seeding only: SESSION POOLER — port 5432 on the pooler host.
# (The direct db.<ref>.supabase.co host is IPv6-only and unreachable from
#  Vercel builders and many ISPs — use the pooler host instead.)
# Format: postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Supabase project (public values; used for docs / future client SDK use)
NEXT_PUBLIC_SUPABASE_URL=https://dcwwfdnrerodvhbkosdb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the browser / NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ── App secrets (set strong values in Vercel, never commit real ones) ─
SESSION_SECRET=
ADMIN_PASSWORD=

NEXT_PUBLIC_WHATSAPP_NUMBER=
