# ── Supabase / Postgres ─────────────────────────────────────────────
# Runtime (Vercel): Supabase TRANSACTION POOLER — port 6543.
# Format: postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Migrations & seeding only (local): DIRECT connection — port 5432.
# Format: postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DIRECT_URL=

# Supabase project (public values; used for docs / future client SDK use)
NEXT_PUBLIC_SUPABASE_URL=https://dcwwfdnrerodvhbkosdb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the browser / NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ── App secrets (set strong values in Vercel, never commit real ones) ─
SESSION_SECRET=
ADMIN_PASSWORD=

NEXT_PUBLIC_WHATSAPP_NUMBER=
